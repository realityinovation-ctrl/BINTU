# Copiez les variables utiles dans votre environnement local.
# Ne commitez aucune valeur réelle. Le backend ne charge pas ce fichier tout seul.

# Secret, backend uniquement. Ne jamais le préfixer par VITE_.
CLERK_SECRET_KEY=

# Origines autorisées à présenter un jeton Clerk. Séparez-les par des virgules.
# En development, localhost:5173 et :3000 sont utilisés si cette variable est vide.
# En production (BINTU_ENV=production), une liste vide refuse tous les jetons.
CLERK_AUTHORIZED_PARTIES=

# development ou production. Défaut : development.
BINTU_ENV=development

# Origines CORS. Même règle : défaut local en development, liste vide en production.
BINTU_CORS_ORIGINS=

# Identifiants Clerk réels pour rattacher les diagnostics créés avant Clerk.
# Laisser vide tant que l'organisation et l'utilisateur n'existent pas.
# Le code n'invente pas ces valeurs.
BINTU_DEMO_ORGANIZATION_ID=
BINTU_MIGRATION_USER_ID=

MODEL_API_KEY=

# Délai maximal d'une décision Meta, en secondes. Défaut 60, maximum 120.
META_DECISION_TIMEOUT_SECONDS=60

# Frontend, fichier frontend/.env.local (lu par Vite, ignoré par Git).
# Clé publique uniquement.
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=
