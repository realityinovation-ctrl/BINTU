BINTU_ENV=development
BINTU_HOST=0.0.0.0
BINTU_PORT=8000
BINTU_RELOAD=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bintu

BINTU_CORS_ORIGINS=

# Diagnostic switch: chatgpt | gemini | meta
# Empty = auto (Meta key, else Gemini, else OpenAI). Default stack: Meta.
BINTU_AI_PROVIDER=meta

MODEL_API_KEY=
META_MODEL=muse-spark-1.3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
META_DECISION_TIMEOUT_SECONDS=60

# Contextual assistant (Mem0-style entities + LangGraph state graph)
# BINTU_ASSISTANT_MEMORY=1 keeps extract → memory → summarize before each decision.
BINTU_ASSISTANT_MEMORY=1
# Set BINTU_MEM0=1 to use Mem0 (needs OPENAI_API_KEY for embed/LLM). Else local JSONL.
BINTU_MEM0=0
BINTU_MEMORY_SUMMARY_EVENTS=12
# BINTU_MEMORY_DIR=backend/.memory

BINTU_DEMO_ORGANIZATION_ID=
BINTU_MIGRATION_USER_ID=

# Auth Google (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID Web)
# Authorized JavaScript origins: http://localhost:8081 , http://127.0.0.1:8081
# Authorized redirect URIs: http://localhost:8081 , http://127.0.0.1:8081
GOOGLE_CLIENT_ID=
# Si GOOGLE_CLIENT_ID est défini, l'API exige une session Bearer (sauf BINTU_REQUIRE_AUTH=0)
# BINTU_REQUIRE_AUTH=1
BINTU_SESSION_TTL_HOURS=12
BINTU_FREE_MESSAGES_PER_DAY=40
BINTU_FREE_LIVE_MINUTES_PER_DAY=15
BINTU_FREE_INVESTIGATIONS_PER_DAY=5
