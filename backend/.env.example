# Local process environment only. No real secret belongs in this file.
# The server reads the process environment. It does not load this file.

BINTU_ENV=development
BINTU_BOOTSTRAP_CODE=
BINTU_ALLOWED_ORIGINS=http://localhost:5173

# HMAC key for the CSRF token. Put a long random value in the process environment.
# This file stays empty. The token is derived and is not stored.
BINTU_CSRF_SECRET=

# Comma-separated proxy addresses or CIDR ranges. Empty ignores X-Forwarded-For.
BINTU_TRUSTED_PROXIES=
# Remove BINTU_BOOTSTRAP_CODE from the environment after the first organization exists.
# Set this to true only when another organization must be created with the same code.
BINTU_BOOTSTRAP_ALLOW_MULTIPLE=

# Absolute lifetime and idle lifetime, in seconds.
BINTU_SESSION_ABSOLUTE_SECONDS=43200
BINTU_SESSION_IDLE_SECONDS=3600
BINTU_INVITATION_SECONDS=604800

# Argon2id. Production default: 19456 KiB, 2 passes, 1 lane.
BINTU_ARGON2_MEMORY_KIB=19456
BINTU_ARGON2_TIME_COST=2
BINTU_ARGON2_PARALLELISM=1

# Temporary block for register, login, and invitation creation.
BINTU_RATE_LIMIT_MAX=5
BINTU_RATE_LIMIT_WINDOW_SECONDS=900
BINTU_RATE_LIMIT_BLOCK_SECONDS=900
